<%
  const isEdit = Boolean(karyawan);
  const v = values || {};
  const val = (key, fallback = '') => (v[key] === null || v[key] === undefined ? fallback : v[key]);
%>

<%- include('../partials/page-head', {
      title: title,
      subtitle: subtitle,
      crumbs: crumbs
    }) %>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger">
    <div class="fw-semibold mb-1"><i class="bi bi-exclamation-octagon-fill me-1"></i>Periksa kembali isian berikut:</div>
    <ul class="mb-0 ps-3">
      <% errors.forEach(function (e) { %><li><%= e.msg %></li><% }); %>
    </ul>
  </div>
<% } %>

<form method="post" action="<%= isEdit ? `/karyawan/${karyawan.id}?_method=PUT` : '/karyawan/tambah' %>" novalidate data-dirty-guard>
  <div class="row g-4">

    <!-- KOLOM KIRI -->
    <div class="col-xl-8">
      <div class="card mb-4">
        <div class="card-header"><span><i class="bi bi-person-vcard me-1"></i>Data Pribadi</span></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" for="nip">NIP <span class="text-danger">*</span></label>
              <input type="text" class="form-control num" id="nip" name="nip" value="<%= val('nip', suggestNip) %>" required>
            </div>
            <div class="col-md-8">
              <label class="form-label" for="nama_lengkap">Nama Lengkap <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nama_lengkap" name="nama_lengkap"
                     value="<%= val('nama_lengkap') %>" required placeholder="Sesuai KTP / akta kelahiran">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="nik">NIK</label>
              <input type="text" class="form-control num" id="nik" name="nik" value="<%= val('nik') %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="jenis_kelamin">Jenis Kelamin</label>
              <select class="form-select" id="jenis_kelamin" name="jenis_kelamin">
                <option value="L" <%= val('jenis_kelamin', 'L') === 'L' ? 'selected' : '' %>>Laki-laki</option>
                <option value="P" <%= val('jenis_kelamin') === 'P' ? 'selected' : '' %>>Perempuan</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="tempat_lahir">Tempat Lahir</label>
              <input type="text" class="form-control" id="tempat_lahir" name="tempat_lahir" value="<%= val('tempat_lahir') %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="tanggal_lahir">Tanggal Lahir</label>
              <input type="date" class="form-control" id="tanggal_lahir" name="tanggal_lahir" value="<%= val('tanggal_lahir') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="no_hp">Nomor HP</label>
              <input type="text" class="form-control num" id="no_hp" name="no_hp" value="<%= val('no_hp') %>" placeholder="08xxxxxxxxxx">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="email">Email</label>
              <input type="email" class="form-control" id="email" name="email" value="<%= val('email') %>"
                     placeholder="dipakai untuk login sistem">
            </div>
            <div class="col-12">
              <label class="form-label" for="alamat">Alamat Domisili</label>
              <textarea class="form-control" id="alamat" name="alamat" rows="2"><%= val('alamat') %></textarea>
            </div>
            <div class="col-12">
              <label class="form-label" for="alamat_darurat">Kontak Darurat</label>
              <input type="text" class="form-control" id="alamat_darurat" name="alamat_darurat"
                     value="<%= val('alamat_darurat') %>" placeholder="Nama & nomor HP kerabat">
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header"><span><i class="bi bi-briefcase me-1"></i>Data Kepegawaian</span></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="departemen_id">Departemen</label>
              <select class="form-select" id="departemen_id" name="departemen_id">
                <option value="">- Tidak ditentukan -</option>
                <% departemen.forEach(function (d) { %>
                  <option value="<%= d.id %>" <%= String(val('departemen_id')) === String(d.id) ? 'selected' : '' %>>
                    <%= d.nama %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="jabatan">Jabatan</label>
              <input type="text" class="form-control" id="jabatan" name="jabatan" value="<%= val('jabatan') %>"
                     placeholder="Contoh: Staf Operasional">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="tipe_kontrak">Jenis Kontrak</label>
              <select class="form-select" id="tipe_kontrak" name="tipe_kontrak">
                <% tipeKontrak.forEach(function (t) { %>
                  <option value="<%= t %>" <%= val('tipe_kontrak', 'PKWT') === t ? 'selected' : '' %>><%= t %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="tanggal_masuk">Tanggal Masuk <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="tanggal_masuk" name="tanggal_masuk"
                     value="<%= val('tanggal_masuk', h.today()) %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="status_karyawan">Status</label>
              <select class="form-select" id="status_karyawan" name="status_karyawan">
                <% Object.keys(STATUS_KARYAWAN).forEach(function (k) { %>
                  <option value="<%= k %>" <%= val('status_karyawan', 'aktif') === k ? 'selected' : '' %>>
                    <%= STATUS_KARYAWAN[k].label %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4 <%= val('status_karyawan', 'aktif') === 'aktif' ? 'd-none' : '' %>" id="wrapKeluar">
              <label class="form-label" for="tanggal_keluar">Tanggal Keluar</label>
              <input type="date" class="form-control" id="tanggal_keluar" name="tanggal_keluar" value="<%= val('tanggal_keluar') %>">
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><span><i class="bi bi-credit-card me-1"></i>Data Rekening</span></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" for="nama_bank">Nama Bank</label>
              <input type="text" class="form-control" id="nama_bank" name="nama_bank" value="<%= val('nama_bank') %>"
                     placeholder="BCA, BRI, Mandiri">
            </div>
            <div class="col-md-8">
              <label class="form-label" for="no_rekening">Nomor Rekening</label>
              <input type="text" class="form-control num" id="no_rekening" name="no_rekening" value="<%= val('no_rekening') %>">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- KOLOM KANAN -->
    <div class="col-xl-4">
      <div class="card mb-4">
        <div class="card-header"><span><i class="bi bi-cash-coin me-1"></i>Komponen Penggajian</span></div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="gaji_pokok">Gaji Pokok <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="text" class="form-control num" id="gaji_pokok" name="gaji_pokok"
                     data-rupiah value="<%= h.toPlainInput(val('gaji_pokok', 0)) %>" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="tunjangan_transport">Tunjangan Transportasi</label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="text" class="form-control num" id="tunjangan_transport" name="tunjangan_transport"
                     data-rupiah value="<%= h.toPlainInput(val('tunjangan_transport', 0)) %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="tunjangan_makan">Tunjangan Makan</label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="text" class="form-control num" id="tunjangan_makan" name="tunjangan_makan"
                     data-rupiah value="<%= h.toPlainInput(val('tunjangan_makan', 0)) %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="tunjangan_lain">Tunjangan Tetap Lainnya</label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="text" class="form-control num" id="tunjangan_lain" name="tunjangan_lain"
                     data-rupiah value="<%= h.toPlainInput(val('tunjangan_lain', 0)) %>">
            </div>
          </div>

          <div class="alert alert-light border mb-0">
            <div class="d-flex justify-content-between small">
              <span class="text-muted">Total gaji per bulan</span>
              <strong class="num" id="totalGaji">-</strong>
            </div>
            <div class="form-text mt-1">
              Nilai lembur dihitung otomatis dari data absensi (1 jam kerja = 1 jam, lembur 1,5x).
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><span><i class="bi bi-journal-text me-1"></i>Catatan</span></div>
        <div class="card-body">
          <textarea class="form-control mb-3" name="catatan" rows="3"
                    placeholder="Catatan internal,misalnya riwayat jabatan atau keterangan khusus."><%= val('catatan') %></textarea>
          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-navy">
              <i class="bi bi-save me-1"></i><%= isEdit ? 'Simpan Perubahan' : 'Simpan Karyawan' %>
            </button>
            <a href="<%= isEdit ? `/karyawan/${karyawan.id}` : '/karyawan' %>" class="btn btn-outline-secondary">Batal</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  (function () {
    var select = document.getElementById('status_karyawan');
    var wrap = document.getElementById('wrapKeluar');
    var sync = function () { wrap.classList.toggle('d-none', select.value === 'aktif'); };
    select && select.addEventListener('change', sync);
    sync();

    var fields = ['gaji_pokok', 'tunjangan_transport', 'tunjangan_makan', 'tunjangan_lain'];
    var output = document.getElementById('totalGaji');
    var calc = function () {
      var total = fields.reduce(function (sum, id) {
        return sum + Number((document.getElementById(id).dataset.rawValue || document.getElementById(id).value || 0));
      }, 0);
      output.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(total);
    };
    fields.forEach(function (id) {
      document.getElementById(id) && document.getElementById(id).addEventListener('input', calc);
    });
    calc();
  })();
</script>
