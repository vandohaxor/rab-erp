<%- include('../partials/page-head', { title: title, subtitle: subtitle, crumbs: crumbs, actions: actions }) %>

<div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-3">
  <%- include('../partials/filter-periode', { periode: periode }) %>
  <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
    <i class="bi bi-printer me-1"></i>Cetak
  </button>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="card"><div class="card-body">
      <div class="stat-label">Total Gaji Pokok</div>
      <div class="stat-value num text-navy" style="font-size:1.05rem"><%= h.money(total.gajiPokok) %></div>
    </div></div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card"><div class="card-body">
      <div class="stat-label">Total Tunjangan</div>
      <div class="stat-value num text-success-strong" style="font-size:1.05rem"><%= h.money(total.totalTunjangan) %></div>
    </div></div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card"><div class="card-body">
      <div class="stat-label">Total Lembur</div>
      <div class="stat-value num text-warning-strong" style="font-size:1.05rem"><%= h.money(total.nilaiLembur) %></div>
    </div></div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="card"><div class="card-body">
      <div class="stat-label">Total Dibayarkan</div>
      <div class="stat-value num text-navy" style="font-size:1.05rem"><%= h.money(total.gajiBersih) %></div>
    </div></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span><i class="bi bi-table me-1"></i>Rekap Penggajian <%= h.monthName(periode.bulan) %> <%= periode.tahun %></span>
    <span class="badge text-bg-light border text-muted"><%= daftar.length %> karyawan</span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover table-compact mb-0">
      <thead>
        <tr>
          <th>#</th><th>Karyawan</th><th>Jabatan</th>
          <th class="text-center">Hadir</th><th class="text-end">Lembur</th>
          <th class="text-end">Gaji Pokok</th><th class="text-end">Potongan</th><th class="text-end">Gaji Bersih</th>
          <th class="text-center">Status</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!daftar.length) { %>
          <tr><td colspan="10"><div class="empty-state"><i class="bi bi-inbox"></i><h6>Belum ada slip gaji pada periode ini</h6></div></td></tr>
        <% } %>
        <% daftar.forEach(function (s, i) {
             const m = STATUS_PAYROLL[s.status] || { label: s.status, badge: 'secondary' }; %>
          <tr>
            <td class="num small text-muted"><%= i + 1 %></td>
            <td>
              <div class="small fw-semibold"><%= s.nama_lengkap %></div>
              <div class="text-muted" style="font-size:.7rem"><%= s.nip %></div>
            </td>
            <td class="small text-muted"><%= s.jabatan || '-' %></td>
            <td class="text-center num small"><%= s.hari_hadir %></td>
            <td class="text-end num small"><%= s.menit_lembur ? h.duration(s.menit_lembur) : '-' %></td>
            <td class="text-end num small"><%= h.money(s.gaji_pokok) %></td>
            <td class="text-end num small text-danger-strong"><%= h.money(s.total_potongan) %></td>
            <td class="text-end num fw-semibold"><%= h.money(s.gaji_bersih) %></td>
            <td class="text-center"><span class="badge badge-status text-bg-<%= m.badge %>"><%= m.label %></span></td>
            <td class="text-end"><a href="/payroll/<%= s.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
          </tr>
        <% }); %>
      </tbody>
      <% if (daftar.length) { %>
        <tfoot>
          <tr>
            <th colspan="5" class="text-end">TOTAL</th>
            <th class="text-end num"><%= h.money(total.gajiPokok) %></th>
            <th class="text-end num"><%= h.money(total.totalPotongan) %></th>
            <th class="text-end num"><%= h.money(total.gajiBersih) %></th>
            <th colspan="2"></th>
          </tr>
        </tfoot>
      <% } %>
    </table>
  </div>
  <div class="card-footer small text-muted">
    Tarif dasar lembur: <strong class="num"><%= h.money(param.dasarLemburPerJam) %>/jam</strong>
    dengan faktor pengali <strong><%= param.faktorLembur %>x</strong> dari
    (gaji pokok + tunjangan tetap) &divide; (<%= param.hariKerjaBulanan %> hari &times; <%= param.jamKerjaHarian %> jam).
  </div>
</div>
