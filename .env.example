# ===== KONFIGURASI APLIKASI =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Nama perusahaan (dipakai di header & cetak laporan)
COMPANY_NAME=PT Rajawali Atas Bumi

# Session
SESSION_SECRET=ganti-dengan-string-rahasia-anda-yang-panjang-dan-acak
SESSION_NAME=rab.sid
SESSION_MAX_AGE_MS=28800000

# Database SQLite
DB_FILE=./data/rab.sqlite

# Login default Superadmin (dipakai hanya saat database masih kosong)
DEFAULT_ADMIN_EMAIL=direktur@rajawaliatasbumi.co.id
DEFAULT_ADMIN_PASSWORD=Direktor123!

# Isi data contoh (karyawan, transaksi, absensi) saat install. Default: false
SEED_DEMO=false
